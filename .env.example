# WordPress Serverless Configuration for Vercel Free Tier

# URL principal (auto-detected por Vercel)
WP_URL=https://tudominio.vercel.app

# Email para la cuenta admin de WordPress
ADMIN_EMAIL=admin@example.com

# Base de datos SQLite local (opcional, puede ser externa)
WORDPRESS_DB_HOST=/var/task/wp-content/db.sqlite

# Configuración adicional
WORDPRESS_DB_CHARSET=utf8mb4
VERCEL_ENV=production